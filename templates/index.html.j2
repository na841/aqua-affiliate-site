<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_name }}</title>
<meta name="description" content="{{ site_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="site-header">
  <h1 class="site-title">{{ site_name }}</h1>
  <p class="site-desc">{{ site_description }}</p>
  {% if last_updated %}
  <p class="site-desc">最終更新日：{{ last_updated }}</p>
  {% endif %}
</header>
<main>
  <div class="author-card">
    <div class="author-emoji">{{ author_emoji }}</div>
    <div>
      <p class="author-name">{{ author_name }}</p>
      <p class="author-bio">{{ author_bio }}</p>
    </div>
  </div>

  <div class="article-grid">
    {% for a in articles %}
    <div class="article-card">
      <a href="articles/{{ a.slug }}.html">{{ a.title }}</a>
    </div>
    {% endfor %}
  </div>
</main>
<footer>&copy; {{ site_name }} / 本サイトはアフィリエイト広告を含みます</footer>
</body>
</html>
